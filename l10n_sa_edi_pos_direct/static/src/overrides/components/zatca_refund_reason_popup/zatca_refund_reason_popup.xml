<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Odoo 17 compatible popup template using AbstractAwaitablePopup pattern -->
    <t t-name="l10n_sa_edi_pos_direct.ZatcaRefundReasonPopup">
        <div class="popup popup-zatca-refund-reason">
            <div class="modal-header">
                <h4 class="modal-title title drag-handle">
                    <t t-esc="props.title" />
                </h4>
            </div>
            <main class="modal-body zatca-refund-reason-popup">
                <!-- Refund Reason Selection -->
                <div class="mb-3">
                    <label for="zatca_refund_reason" class="form-label fw-bold">
                        Refund Reason <span class="text-danger">*</span>
                        <br/>
                        <small class="text-muted">سبب الاسترداد</small>
                    </label>
                    <select 
                        class="form-select form-control" 
                        id="zatca_refund_reason" 
                        name="l10n_sa_zatca_refund_reason" 
                        t-model="state.l10n_sa_zatca_refund_reason"
                        t-on-change="onReasonChange">
                        <t t-foreach="zatcaRefundReasons" t-as="reason" t-key="reason.value">
                            <option 
                                t-att-value="reason.value"
                                t-att-selected="reason.value === state.l10n_sa_zatca_refund_reason ? 'selected' : undefined">
                                <t t-out="reason.name"/>
                            </option>
                        </t>
                    </select>
                </div>
            </main>
            <footer class="footer modal-footer">
                <div class="button confirm btn btn-lg btn-primary" t-on-click="confirm">
                    <i class="fa fa-check me-1"></i>
                    <t t-esc="props.confirmText" />
                </div>
                <div class="button cancel btn btn-lg btn-secondary" t-on-click="cancel">
                    <i class="fa fa-times me-1"></i>
                    <t t-esc="props.cancelText" />
                </div>
            </footer>
        </div>
    </t>

</templates>
